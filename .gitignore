# ====================== ARIA / Friday Project .gitignore ======================

# Virtual Environment
venv/
.env
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables and secrets (VERY IMPORTANT)
.env
*.env

# Python cache and temporary files
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Log files
*.log
logs/

# JSON data files (optional - you can keep them if you want version history)
# aria_memory.json
# aria_tracker.json

# Large media files (GIF animation is big)
*.gif
*.mp4
*.avi
*.mov

# Build and distribution folders
build/
dist/
*.egg-info/

# Temporary files
*.tmp
*.temp

# Windows specific
$RECYCLE.BIN/
System Volume Information/

# ====================== End of .gitignore ======================